{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-parse",
  "version": "0.2.0",
  "description": "Parser combinators for Effect, ported from Rust's nom and winnow: text, bytes, bits and token streams, streaming input, compiled parsers and Schema integration",
  "keywords": [
    "effect",
    "nom",
    "parser",
    "parser-combinators",
    "typescript",
    "winnow"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-parse#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-parse/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-parse.git"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Input": {
      "types": "./dist/Input.d.ts",
      "default": "./dist/Input.js"
    },
    "./Parser": {
      "types": "./dist/Parser.d.ts",
      "default": "./dist/Parser.js"
    },
    "./Compiler": {
      "types": "./dist/Compiler.d.ts",
      "default": "./dist/Compiler.js"
    },
    "./ParseError": {
      "types": "./dist/ParseError.d.ts",
      "default": "./dist/ParseError.js"
    },
    "./Token": {
      "types": "./dist/Token.d.ts",
      "default": "./dist/Token.js"
    },
    "./Ascii": {
      "types": "./dist/Ascii.d.ts",
      "default": "./dist/Ascii.js"
    },
    "./Text": {
      "types": "./dist/Text.d.ts",
      "default": "./dist/Text.js"
    },
    "./Encoding": {
      "types": "./dist/Encoding.d.ts",
      "default": "./dist/Encoding.js"
    },
    "./Binary": {
      "types": "./dist/Binary.d.ts",
      "default": "./dist/Binary.js"
    },
    "./Bits": {
      "types": "./dist/Bits.d.ts",
      "default": "./dist/Bits.js"
    },
    "./Expression": {
      "types": "./dist/Expression.d.ts",
      "default": "./dist/Expression.js"
    },
    "./Nom": {
      "types": "./dist/Nom.d.ts",
      "default": "./dist/Nom.js"
    },
    "./ParserSchema": {
      "types": "./dist/ParserSchema.d.ts",
      "default": "./dist/ParserSchema.js"
    },
    "./ParserStream": {
      "types": "./dist/ParserStream.d.ts",
      "default": "./dist/ParserStream.js"
    },
    "./Syntax": {
      "types": "./dist/Syntax.d.ts",
      "default": "./dist/Syntax.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && vp fmt && pnpm install --lockfile-only",
    "release": "bash scripts/release.sh",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.28.6"
}
