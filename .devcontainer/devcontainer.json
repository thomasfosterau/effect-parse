{
  "name": "effect-parse",
  // Tag = the catalog's `vite-plus` pin, moved by hand with it (digest from
  // `docker buildx imagetools inspect ghcr.io/voidzero-dev/vite-plus:<tag>`).
  "image": "ghcr.io/voidzero-dev/vite-plus:1.6.0@sha256:eefe84f6bf32756307fe1452b49c81e6b3af98edb328a838ac1e90d6faaa7acc",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  // The container keeps its own node_modules in volumes, so its install never
  // touches the host checkout's (built against another pnpm store). Fresh
  // volumes are root-owned, hence the chown.
  "mounts": [
    "source=effect-parse-node_modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=effect-parse-ripgrep-node_modules-${devcontainerId},target=${containerWorkspaceFolder}/examples/ripgrep/node_modules,type=volume"
  ],
  "postCreateCommand": "sudo chown \"$(id -u):$(id -g)\" node_modules examples/ripgrep/node_modules && vp install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": ["Anthropic.claude-code", "oxc.oxc-vscode"]
    }
  },
  "workspaceFolder": "/workspaces/effect-parse"
}
