{
  "name": "effect-parse",
  // The Vite+ base image: Node + pnpm + the vp CLI. The tag is the catalog's
  // `vite-plus` pin in pnpm-workspace.yaml; Dependabot cannot move it, so bump it
  // by hand on the toolchain PR that moves `vite-plus`. A tag can be moved, so
  // the image is pinned by digest as well (the multi-platform index's): take
  // the new one from `docker buildx imagetools inspect ghcr.io/voidzero-dev/vite-plus:<tag>`.
  "image": "ghcr.io/voidzero-dev/vite-plus:1.6.0@sha256:eefe84f6bf32756307fe1452b49c81e6b3af98edb328a838ac1e90d6faaa7acc",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // The feature is digest-locked (devcontainer-lock.json), but its default
    // `version` is "latest", resolved when the container is built: pin it.
    "ghcr.io/devcontainers-extra/features/ripgrep:1": { "version": "15.2.0" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainer-community/devcontainer-features/jq:1": {}
  },
  // Same provisioning as an agent session: .claude/hooks/session-start.sh installs
  // the pinned Vite+ CLI, links `vp` / `vpx` into ~/.local/bin and runs
  // `vp install --frozen-lockfile` (see that file's header).
  "postCreateCommand": "bash .claude/hooks/session-start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["Anthropic.claude-code", "oxc.oxc-vscode"]
    }
  },
  "workspaceFolder": "/workspaces/effect-parse"
}
